<%- include('../partials/header') %>

<div class="breadcrumb"><a href="/products">Sản phẩm</a><span>/</span><span><%= product.category_name %></span></div>
<section class="detail-layout">
	<div class="detail-image">
		<img src="<%= product.image_url || '/images/no-image.svg' %>" onerror="this.onerror=null;this.src='/images/no-image.svg'" alt="<%= product.name %>">
	</div>
	<div class="detail-copy">
		<p class="eyebrow"><%= product.brand %> / <%= product.category_name %></p>
		<h1><%= product.name %></h1>
		<p class="detail-price"><%= Number(product.price).toLocaleString('vi-VN') %> đ</p>
		<p class="detail-description"><%= product.description || 'Sản phẩm chính hãng, được kiểm tra kỹ trước khi giao đến bạn.' %></p>
		<%- include('../partials/purchase-policies') %>
		<p class="stock-line"><span class="status-dot"></span><%= product.stock_qty > 0 ? `Còn ${product.stock_qty} sản phẩm trong kho` : 'Tạm hết hàng' %></p>
		<form class="add-form" method="post" action="/cart/add">
			<input type="hidden" name="product_id" value="<%= product.id %>">
			<div class="quantity-field">
				<label for="product-quantity-<%= product.id %>">Số lượng</label>
				<div class="quantity-control" data-quantity-control>
					<button type="button" data-step="-1" aria-label="Giảm số lượng" <%= product.stock_qty < 1 ? 'disabled' : '' %>>-</button>
					<input id="product-quantity-<%= product.id %>" type="number" name="quantity" value="1" min="1" max="<%= product.stock_qty %>" step="1" inputmode="numeric" required <%= product.stock_qty < 1 ? 'disabled' : '' %>>
					<button type="button" data-step="1" aria-label="Tăng số lượng" <%= product.stock_qty < 1 ? 'disabled' : '' %>>+</button>
				</div>
			</div>
			<div class="product-actions">
				<button class="btn btn-primary" type="submit" name="intent" value="cart" <%= product.stock_qty < 1 ? 'disabled' : '' %>>
					<i class="fas fa-cart-plus" aria-hidden="true"></i> Thêm vào giỏ
				</button>
				<button class="btn btn-buy-now" type="submit" name="intent" value="buy_now" <%= product.stock_qty < 1 ? 'disabled' : '' %>>
					<i class="fas fa-bolt" aria-hidden="true"></i> Mua ngay
				</button>
			</div>
		</form>
	</div>
</section>

<script src="/js/quantity-control.js" defer></script>
<%- include('../partials/footer') %>
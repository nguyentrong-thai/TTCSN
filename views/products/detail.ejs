<%- include('../partials/header') %><div class="breadcrumb"><a href="/products">Sản phẩm</a><span>/</span><span><%= product.category_name %></span></div><section class="detail-layout"><div class="detail-image"><img src="<%= product.image_url || '/images/no-image.svg' %>" onerror="this.src='/images/no-image.svg'" alt="<%= product.name %>"></div><div class="detail-copy"><p class="eyebrow"><%= product.brand %> / <%= product.category_name %></p><h1><%= product.name %></h1><p class="detail-price"><%= Number(product.price).toLocaleString('vi-VN') %> đ</p><p class="detail-description"><%= product.description || 'Sản phẩm chính hãng, được kiểm tra kỹ trước khi giao đến bạn.' %></p><p class="stock-line"><span class="status-dot"></span><%= product.stock_qty > 0 ? `Còn ${product.stock_qty} sản phẩm trong kho` : 'Tạm hết hàng' %></p><form class="add-form" method="post" action="/cart/add"><input type="hidden" name="product_id" value="<%= product.id %>"><label>Số lượng<input type="number" name="quantity" value="1" min="1" max="<%= product.stock_qty %>" <%= product.stock_qty < 1 ? 'disabled' : '' %>></label><button class="btn btn-primary" type="submit" <%= product.stock_qty < 1 ? 'disabled' : '' %>>Thêm vào giỏ</button></form></div></section><%- include('../partials/footer') %>
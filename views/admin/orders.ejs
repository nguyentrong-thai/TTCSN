<%- include('../partials/header') %>
<section class="page-heading"><p class="eyebrow">QUẢN TRỊ ĐƠN HÀNG</p><h1>Danh sách đơn hàng</h1></section>
<div class="admin-table"><% if (!orders.length) { %><div class="empty-state"><h2>Chưa có đơn hàng</h2></div><% } %><% orders.forEach((order) => { %><div class="table-row order-row"><div><strong>#<%= order.id %> · <%= order.full_name %></strong><small><%= order.email %> · <%= new Date(order.created_at).toLocaleString('vi-VN') %> · <%= Number(order.total_amount).toLocaleString('vi-VN') %> đ</small></div><form method="post" action="/admin/orders/<%= order.id %>/status"><select name="status"><% [['pending','Chờ xác nhận'],['confirmed','Đã xác nhận'],['shipping','Đang giao'],['completed','Hoàn tất'],['cancelled','Đã hủy']].forEach(([value, label]) => { %><option value="<%= value %>" <%= order.status === value ? 'selected' : '' %>><%= label %></option><% }) %></select><button class="btn" type="submit">Cập nhật</button></form></div><% }) %></div>
<%- include('../partials/footer') %>
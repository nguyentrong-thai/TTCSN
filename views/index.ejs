<%- include('partials/header') %>

<section class="hero"><div class="hero-copy"><p class="eyebrow">CÔNG NGHỆ CHO ĐỜI SỐNG HIỆN ĐẠI</p><h1>Món đồ bạn cần.<br><em>Trải nghiệm bạn muốn.</em></h1><p>Khám phá thiết bị chính hãng, giá rõ ràng và được chọn lọc cho từng khoảnh khắc của bạn.</p><a href="/products" class="btn btn-primary">Khám phá sản phẩm <span>↗</span></a></div><div class="hero-orbit"><div class="orbit-ring"></div><div class="hero-device">⌁</div><p>NEW<br><strong>2024</strong></p></div></section>
<section class="category-strip"><div class="section-row"><div><p class="eyebrow">KHÁM PHÁ THEO NHU CẦU</p><h2>Danh mục nổi bật</h2></div><a href="/products">Xem tất cả ↗</a></div><div class="category-list"><% categories.forEach((cat, index) => { %><a class="category-item category-<%= index %>" href="/products?category=<%= cat.slug %>"><span class="category-icon"><%= ['⌁', '▱', '◉', '◌'][index % 4] %></span><strong><%= cat.name %></strong><small><%= cat.description || 'Khám phá ngay' %></small></a><% }); %></div></section>
<section class="products"><div class="section-row"><div><p class="eyebrow">ĐƯỢC YÊU THÍCH TUẦN NÀY</p><h2>Sản phẩm nổi bật</h2></div><a href="/products">Xem tất cả ↗</a></div><div class="product-grid"><% products.forEach(function(p) { %><article class="product-card"><a class="product-image" href="/products/<%= p.id %>"><img src="<%= p.image_url || '/images/no-image.svg' %>" onerror="this.src='/images/no-image.svg'" alt="<%= p.name %>"></a><div class="product-copy"><p class="product-category"><%= p.brand %></p><h3><a href="/products/<%= p.id %>"><%= p.name %></a></h3><div class="product-bottom"><strong class="price"><%= Number(p.price).toLocaleString('vi-VN') %> đ</strong><span class="stock"><%= p.stock_qty > 0 ? 'Còn hàng' : 'Hết hàng' %></span></div></div></article><% }); %></div></section>

<%- include('partials/footer') %>

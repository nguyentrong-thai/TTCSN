<%- include('../partials/header') %>
<section class="page-heading"><p class="eyebrow">LỊCH SỬ MUA HÀNG</p><h1>Đơn hàng của tôi</h1></section>
<div class="admin-table"><% if (!orders.length) { %><div class="empty-state"><h2>Bạn chưa có đơn hàng</h2><a class="btn btn-primary" href="/products">Mua sắm ngay</a></div><% } %><% orders.forEach((order) => { %><div class="table-row order-row"><div><strong>Đơn hàng #<%= order.id %></strong><small><%= new Date(order.created_at).toLocaleString('vi-VN') %> · <%= Number(order.total_amount).toLocaleString('vi-VN') %> đ</small></div><div><span class="order-status status-<%= order.status %>"><%= { pending: 'Chờ xác nhận', confirmed: 'Đã xác nhận', shipping: 'Đang giao', completed: 'Hoàn tất', cancelled: 'Đã hủy' }[order.status] %></span><% if (order.status === 'pending') { %><form method="post" action="/orders/<%= order.id %>/cancel"><button class="text-button" type="submit">Hủy đơn</button></form><% } %></div></div><% }) %></div>
<%- include('../partials/footer') %>
<%- include('../partials/header') %><section class="page-heading"><p class="eyebrow">GIỎ HÀNG CỦA BẠN</p><h1>Sẵn sàng để đặt hàng?</h1></section><% if (!cart.length) { %><div class="empty-state"><h2>Giỏ hàng đang trống</h2><p>Thêm một thiết bị bạn thích, rồi quay lại đây.</p><a class="btn btn-primary" href="/products">Khám phá sản phẩm</a></div><% } else { %><div class="cart-layout"><div class="cart-items"><% cart.forEach((item) => { %><article class="cart-item"><img src="<%= item.image_url || '/images/no-image.svg' %>" onerror="this.src='/images/no-image.svg'" alt="<%= item.name %>"><div><h2><a href="/products/<%= item.id %>"><%= item.name %></a></h2><p><%= item.quantity %> x <%= item.price.toLocaleString('vi-VN') %> đ</p></div><strong><%= (item.quantity * item.price).toLocaleString('vi-VN') %> đ</strong><form method="post" action="/cart/remove/<%= item.id %>"><button class="text-button" type="submit">Xóa</button></form></article><% }) %></div><aside class="cart-summary"><p class="eyebrow">TẠM TÍNH</p><div class="summary-total"><span>Tổng cộng</span><strong><%= total.toLocaleString('vi-VN') %> đ</strong></div><a class="btn btn-primary btn-wide" href="/orders/checkout">Tiến hành thanh toán</a><small>Kiểm tra thông tin giao hàng trước khi xác nhận đơn.</small></aside></div><% } %><%- include('../partials/footer') %>